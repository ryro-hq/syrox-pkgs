// Catalog smoke project: an authenticated local input exports pure factories.
inputs { catalog = "path:recipes"; }

outputs {
    hello: std::Package = catalog::hello();
    hello_sources: std::Acquisition = catalog::hello_sources();
    hello_build: std::AutotoolsBuild = catalog::hello_build();
    hello_build_inputs: std::BuildInputs = catalog::hello_build_inputs();
    bootstrap: std::Package = catalog::bootstrap();
    bootstrap_sources: std::Acquisition = catalog::bootstrap_sources();
    bootstrap_build: std::AutotoolsBuild = catalog::bootstrap_build();
    glibc: std::Package = catalog::glibc();
    glibc_sources: std::Acquisition = catalog::glibc_sources();
    glibc_build: std::GlibcBuild = catalog::glibc_build();
    hello_application: std::Application = catalog::hello_application();
    default_application: std::DefaultApplication = std::DefaultApplication { package = "hello"; };
    default_build: std::DefaultBuild = std::DefaultBuild { package = "hello"; };
}
