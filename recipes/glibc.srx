pub fn recipe() -> std::CatalogRecipe {
    std::CatalogRecipe {
        package = std::Package { id = "glibc"; dependencies = []; };
        acquisition = std::Acquisition {
            package = "glibc";
            sources = [std::SourceRequest {
                url = "https://ftp.gnu.org/gnu/glibc/glibc-2.44.tar.xz";
                sha256 = "37f600f2bef3c5e8300147059568b2a2e40a7ad6ccc65ce942556d49429cc667";
                maximum_bytes = 33554432;
            }];
        };
        build = std::Build::Glibc(std::GlibcBuild {
            package = "glibc";
            source_directory = "glibc-2.44";
            entry = "usr/lib/ld-linux-x86-64.so.2";
            timeout_seconds = 1800;
        });
        build_inputs = std::Option::None;
        application = std::Option::None;
    }
}
